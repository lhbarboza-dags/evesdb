# ---------------------------------------------------------------- database (existing PostgreSQL, schema is never modified)
# Inside Docker, "host.docker.internal" is the machine running Docker.
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/evesdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
# validate (default) fails fast if an entity no longer matches the schema; never use update/create on the shared DB.
JPA_DDL_AUTO=validate

# ---------------------------------------------------------------- legacy password cipher (MUST match the ZK app's AES256 constants
# SECRET_KEY / SALT in org.sibol.eves.app.AES256, otherwise existing users cannot log in)
LEGACY_AES_SECRET=
LEGACY_AES_SALT=
# true = re-hash passwords to bcrypt on login. Keep false while the old ZK app still uses the same database.
APP_AUTH_UPGRADE_HASH=false

# ---------------------------------------------------------------- public URL used in e-mailed links (verify, reset, invitation)
APP_BASE_URL=http://localhost:8080
WEB_PORT=8080

# ---------------------------------------------------------------- e-mail (Gmail SMTP with an app password, as before)
MAIL_ENABLED=true
MAIL_FROM=sibol.eves.dev@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------- reCAPTCHA v2 checkbox (register, forgot password, contact)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# ---------------------------------------------------------------- Google Maps JavaScript API (search → Map tab)
GOOGLE_MAPS_API_KEY=
