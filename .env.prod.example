# Production settings (copy to .env.prod on the server, chmod 600). Never commit .env.prod.
# ---------------------------------------------------------------- site
DOMAIN=eves.example.org
ACME_EMAIL=admin@example.org
APP_BASE_URL=https://eves.example.org

# ---------------------------------------------------------------- database (container "db"; data restored from a pg_dump)
POSTGRES_USER=sibol
POSTGRES_PASSWORD=change-me-long-random
JPA_DDL_AUTO=validate

# ---------------------------------------------------------------- legacy password cipher (values from the old AES256.java)
LEGACY_AES_SECRET=
LEGACY_AES_SALT=
APP_AUTH_UPGRADE_HASH=false

# ---------------------------------------------------------------- e-mail (create a NEW Gmail app password; the old one is in git history)
MAIL_ENABLED=true
MAIL_FROM=sibol.eves.dev@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sibol.eves.dev@gmail.com
SMTP_PASSWORD=

# ---------------------------------------------------------------- reCAPTCHA v2 checkbox, keys registered for DOMAIN
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# ---------------------------------------------------------------- Google Maps JavaScript API key, restricted to https://DOMAIN/*
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------- backups (deploy/backup.sh)
OCI_BUCKET=sibol-eves-backups
