# Self-contained build (npm runs inside Docker). Use only when the Docker build can reach the npm registry:
#   docker build -f Dockerfile.multistage .
# ---- build
FROM node:20.18-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# ---- serve (static SPA + reverse proxy to the API, same origin for the session cookie)
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
